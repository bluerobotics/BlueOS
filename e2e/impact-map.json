{
  "_comment": "Maps frontend source paths to the test tags that cover them. First matching rule wins. A changed file under core/frontend or e2e that matches no rule runs the FULL suite, never nothing: a missing rule costs minutes, a wrong skip ships a bug. select-tests.mjs prints `unmatched: <file>` so the map gets extended. Never fix an unmatched file with a rule that selects nothing, either map it to its page tags or leave it unmatched. Files outside core/frontend and e2e select nothing.",
  "rules": [
    { "match": "core/frontend/src/views/{MainView,PageNotFound}.vue", "tags": ["@dashboard"] },
    { "match": "core/frontend/src/views/Autopilot.vue", "tags": ["@autopilot"] },
    { "match": "core/frontend/src/views/EndpointView.vue", "tags": ["@endpoints"] },
    { "match": "core/frontend/src/components/autopilot/Endpoint*", "tags": ["@endpoints"] },
    { "match": "core/frontend/src/components/autopilot/**", "tags": ["@autopilot", "@endpoints", "@bridges"] },
    { "match": "core/frontend/src/views/ParameterEditorView.vue", "tags": ["@parameters"] },
    { "match": "core/frontend/src/components/parameter-editor/**", "tags": ["@parameters", "@vehicle-setup"] },
    { "match": "core/frontend/src/views/VehicleSetupView.vue", "tags": ["@vehicle-setup"] },
    { "match": "core/frontend/src/components/vehiclesetup/**", "tags": ["@vehicle-setup"] },
    { "match": "core/frontend/src/views/Pings.vue", "tags": ["@pings"] },
    { "match": "core/frontend/src/components/ping/**", "tags": ["@pings"] },
    { "match": "core/frontend/src/store/ping.ts", "tags": ["@pings"] },
    { "match": "core/frontend/src/views/LogView.vue", "tags": ["@logs"] },
    { "match": "core/frontend/src/components/logs/**", "tags": ["@logs"] },
    { "match": "core/frontend/src/views/VideoManagerView.vue", "tags": ["@video"] },
    { "match": "core/frontend/src/components/video-manager/**", "tags": ["@video", "@dashboard"] },
    { "match": "core/frontend/src/store/video.ts", "tags": ["@video", "@dashboard"] },
    { "match": "core/frontend/src/views/VersionChooser.vue", "tags": ["@version-chooser"] },
    { "match": "core/frontend/src/components/version-chooser/**", "tags": ["@version-chooser"] },
    { "match": "core/frontend/src/views/ExtensionManagerView.vue", "tags": ["@extensions"] },
    { "match": "core/frontend/src/components/kraken/**", "tags": ["@extensions"] },
    { "match": "core/frontend/src/views/SystemInformationView.vue", "tags": ["@system-information"] },
    { "match": "core/frontend/src/components/system-information/**", "tags": ["@system-information"] },
    { "match": "core/frontend/src/views/NetworkTestView.vue", "tags": ["@network-test"] },
    { "match": "core/frontend/src/components/speedtest/**", "tags": ["@network-test"] },
    { "match": "core/frontend/src/views/SettingsView.vue", "tags": ["@settings"] },
    { "match": "core/frontend/src/views/AvailableServicesView.vue", "tags": ["@available-services"] },
    { "match": "core/frontend/src/components/scanner/**", "tags": ["@available-services"] },
    { "match": "core/frontend/src/views/BagEditorView.vue", "tags": ["@bag-editor"] },
    { "match": "core/frontend/src/views/FileBrowserView.vue", "tags": ["@file-browser"] },
    { "match": "core/frontend/src/views/MavlinkInspectorView.vue", "tags": ["@mavlink-inspector"] },
    { "match": "core/frontend/src/components/mavlink-inspector/**", "tags": ["@mavlink-inspector"] },
    { "match": "core/frontend/src/views/NMEAInjectorView.vue", "tags": ["@nmea-injector"] },
    { "match": "core/frontend/src/components/nmea-injector/**", "tags": ["@nmea-injector"] },
    { "match": "core/frontend/src/store/nmea-injector.ts", "tags": ["@nmea-injector"] },
    { "match": "core/frontend/src/views/BridgesView.vue", "tags": ["@bridges"] },
    { "match": "core/frontend/src/components/bridges/**", "tags": ["@bridges"] },
    { "match": "core/frontend/src/store/bridget.ts", "tags": ["@bridges"] },
    { "match": "core/frontend/src/views/TerminalView.vue", "tags": ["@terminal"] },
    { "match": "core/frontend/src/components/{wifi,ethernet,health,beacon,cloud,notifications}/**", "tags": ["@shell"] },
    { "match": "core/frontend/src/components/app/**", "tags": ["@shell"] },
    { "match": "core/frontend/src/widgets/**", "tags": ["@shell", "@dashboard"] },
    { "match": "core/frontend/src/components/{common,utils,wizard,vue-tour}/**", "tags": ["*"] },
    { "match": "core/frontend/src/{App.vue,menus.ts,main.ts,cosmos.ts,one-more-time.ts}", "tags": ["*"] },
    { "match": "core/frontend/src/{router,store,plugins,libs,utils,types,alerts,style,assets,PX4-parameters}/**", "tags": ["*"] },
    { "match": "core/frontend/{package.json,bun.lockb,vite.config.js,tsconfig.json,index.html}", "tags": ["*"] },
    { "match": "core/frontend/public/**", "tags": ["*"] },
    { "match": "e2e/fixtures/**", "tags": ["*"] },
    { "match": "e2e/{playwright.config.ts,global-setup.ts,global-teardown.ts,package.json,bun.lock,tsconfig.json}", "tags": ["*"] },
    { "match": "e2e/{impact-map.json,select-tests.mjs,check-impact-map.mjs}", "tags": ["*"] },
    { "match": "e2e/tests/seed.spec.ts", "tags": ["*"] }
  ]
}
