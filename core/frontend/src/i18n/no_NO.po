msgstr "En ny versjon er tilgjengelig!"

#: src/components/vehiclesetup/configuration/compass/CompassLearn.vue
msgid "A valid global region is required for Compass Learn to estimate the local world magnetic field."
msgstr "En gyldig global region kreves for at Compass Learn skal kunne estimere det lokale jordmagnetfeltet."

#: src/components/vehiclesetup/configuration/compass/FullCompassCalibrator.vue
msgid "A valid global region/position is <strong>recomended</strong> for Onboard Calibration to estimate the local world magnetic field."
msgstr "En gyldig global region/posisjon er <strong>anbefalt</strong> for at innebygd kalibrering skal kunne estimere det lokale jordmagnetfeltet."

#: src/components/vehiclesetup/configuration/compass/LargeVehicleCompassCalibrator.vue
msgid "A valid global region/position is required to estimate the local world magnetic field."
msgstr "En gyldig global region/posisjon kreves for å estimere det lokale jordmagnetfeltet."

