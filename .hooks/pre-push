#!/usr/bin/env bash

set -e

ROOT_DIR=$(git rev-parse --show-toplevel)
cd "$ROOT_DIR"

CORE_DIR="$ROOT_DIR/core"
# shellcheck disable=SC2034
declare -a EMPTY_PATHS=()

source "$ROOT_DIR/.hooks/lib/common.sh"
source "$ROOT_DIR/.hooks/lib/python_checks.sh"

declare -a ISORT_CONFIG_ARGS=(--settings-path "$CORE_DIR/pyproject.toml")
declare -a BLACK_CONFIG_ARGS=(--config "$CORE_DIR/pyproject.toml")
declare -a ISORT_CHECK_ARGS=(--check-only --diff)
declare -a BLACK_CHECK_ARGS=(--check --diff)

# shellcheck disable=SC2034
isort_args=("${ISORT_CONFIG_ARGS[@]}" "${ISORT_CHECK_ARGS[@]}")
# shellcheck disable=SC2034
black_args=("${BLACK_CONFIG_ARGS[@]}" "${BLACK_CHECK_ARGS[@]}")
fixing=false

for arg in "$@"; do
    case $arg in
        --fix)
            # shellcheck disable=SC2034
            isort_args=("${ISORT_CONFIG_ARGS[@]}")
            # shellcheck disable=SC2034
            black_args=("${BLACK_CONFIG_ARGS[@]}")
            fixing=true
            ;;
        -h|--help)
            print_usage
            exit 0
            ;;
        *)
            echo "Unknown argument: $arg"
            print_usage
            exit 1
            ;;
    esac
done

if [ "$fixing" = true ]; then
    echo "Fix mode enabled. Running isort/black only."
fi

check_no_fixup_commits
check_required_tools
run_nginx_validation

echo "Running pre push hook!"
verify_tag_if_needed
run_shellcheck_suite

run_lint_checks() {
    local name="$1"
    local dir="$2"
    echo "Running $name checks..."
    local files=()
    mapfile -t files < <(find "$dir" -name .venv -prune -o -name "*.py" -type f -print)

    if [ "${#files[@]}" -eq 0 ]; then
        echo "No $name Python files found, skipping."
        return
    fi

    echo "Running isort ($name).."
    isort "${isort_args[@]}" "${files[@]}"

    echo "Running black ($name).."
    black "${black_args[@]}" "${files[@]}"

    if [ "$fixing" = true ]; then
        return
    fi

    echo "Running ruff ($name).."
    ruff check --config "$CORE_DIR/pyproject.toml" "${files[@]}"

    echo "Running pylint ($name).."
    pylint --rcfile "$CORE_DIR/pyproject.toml" "${files[@]}"

    echo "Running mypy ($name).."
    (cd "$dir" && mypy --config-file "$CORE_DIR/pyproject.toml" --explicit-package-bases .)
}

run_environment_phase "core" "$CORE_DIR" EMPTY_PATHS EMPTY_PATHS true
# Bootstrap checks reuse the venv (run_environment_phase runs in a subshell so we re-activate)
# shellcheck disable=SC1091
source "$CORE_DIR/.venv/bin/activate"
run_lint_checks "bootstrap" "$ROOT_DIR/bootstrap"
run_lint_checks "e2e" "$ROOT_DIR/tests/e2e"

exit 0
